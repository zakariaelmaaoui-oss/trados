PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
# Generate once with: npx web-push generate-vapid-keys  (if omitted, keys are generated and stored in the DB)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Set to 1 when served over HTTPS (required for Web Push outside localhost)
COOKIE_SECURE=0
# Needed only if outbound traffic must go through a proxy (Node 22.21+)
NODE_USE_ENV_PROXY=0
