# --- Vercel (set these in Project → Settings → Environment Variables) ---
# Added automatically when you connect a Neon database to the project:
DATABASE_URL=
# Any long random string; cron-job.org sends it as "Authorization: Bearer <value>"
CRON_SECRET=
# Optional: contact for push services
VAPID_SUBJECT=mailto:you@example.com

# --- Local only ---
PORT=3000
HOST=127.0.0.1
# Without DATABASE_URL an embedded Postgres is stored here:
DATA_DIR=./data
